{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)+$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "solution_allowed_after": {
      "default": 3,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "levels": {
      "minItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "type": {
            "type": "string",
            "enum": [
              "ask",
              "hint",
              "smaller_hint",
              "demonstrate",
              "explain",
              "solution"
            ]
          },
          "text_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
          }
        },
        "required": [
          "level",
          "type",
          "text_key"
        ]
      }
    },
    "status": {
      "default": "draft",
      "type": "string",
      "enum": [
        "draft",
        "reviewed",
        "approved"
      ]
    }
  },
  "required": [
    "id",
    "version",
    "levels"
  ],
  "title": "hint-ladder"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)+$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "name_key": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
    },
    "parent": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)+$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "version",
    "name_key"
  ],
  "title": "interest"
}

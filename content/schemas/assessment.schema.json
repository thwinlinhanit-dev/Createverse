{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)+$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "evidence": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "signal": {
            "type": "string",
            "minLength": 1
          },
          "skill": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)+$"
          },
          "concept": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)+$"
          },
          "strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "signal",
          "strength"
        ]
      }
    },
    "mastery_rule": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "version",
    "evidence",
    "mastery_rule"
  ],
  "title": "assessment"
}

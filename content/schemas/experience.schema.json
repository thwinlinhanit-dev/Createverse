{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "experience_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)+$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "stage": {
      "type": "string",
      "enum": [
        "junior",
        "explorer",
        "maker"
      ]
    },
    "age_range": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "learning_objectives": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)+$"
      }
    },
    "mission": {
      "type": "object",
      "properties": {
        "title_key": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
        },
        "objective_key": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
        }
      },
      "required": [
        "title_key",
        "objective_key"
      ]
    },
    "seed": {
      "default": 0,
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "variables": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "max_pieces": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "budget": {
          "type": "number",
          "minimum": 0
        },
        "gap_width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "piece_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "materials": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "cost": {
                "type": "number",
                "minimum": 0
              },
              "strength": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "cost",
              "strength"
            ]
          }
        },
        "vehicles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "max_pieces",
        "budget"
      ]
    },
    "ui": {
      "default": {
        "read_aloud": true,
        "no_text_required": false,
        "large_targets": false,
        "force_view": false,
        "test_log": false
      },
      "type": "object",
      "properties": {
        "read_aloud": {
          "default": true,
          "type": "boolean"
        },
        "no_text_required": {
          "default": false,
          "type": "boolean"
        },
        "large_targets": {
          "default": false,
          "type": "boolean"
        },
        "force_view": {
          "default": false,
          "type": "boolean"
        },
        "test_log": {
          "default": false,
          "type": "boolean"
        }
      }
    },
    "assessment": {
      "type": "object",
      "properties": {
        "success_conditions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "success_conditions"
      ]
    },
    "telemetry": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "step_overrides": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "preset": {
            "type": "string",
            "minLength": 1
          },
          "build_enabled": {
            "type": "boolean"
          },
          "vehicle": {
            "type": "string",
            "minLength": 1
          },
          "vehicles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "max_pieces": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "budget": {
            "type": "number",
            "minimum": 0
          },
          "pieces": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "force_view": {
            "type": "boolean"
          },
          "bonus_vehicle": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "experience_id",
    "version",
    "stage",
    "age_range",
    "difficulty",
    "mission",
    "constraints",
    "assessment"
  ],
  "title": "experience"
}

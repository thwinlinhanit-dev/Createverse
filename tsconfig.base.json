{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@createverse/shared-types": ["packages/shared-types/src/index.ts"],
      "@createverse/learning-core": ["packages/learning-core/src/index.ts"],
      "@createverse/ai-core": ["packages/ai-core/src/index.ts"],
      "@createverse/content-sdk": ["packages/content-sdk/src/index.ts"],
      "@createverse/design-tokens": ["packages/design-tokens/src/index.ts"],
      "@createverse/i18n": ["packages/i18n/src/index.ts"],
      "@createverse/ui": ["packages/ui/src/index.ts"],
      "@createverse/experience-runtime": ["packages/experience-runtime/src/index.ts"]
    }
  }
}
